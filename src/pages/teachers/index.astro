---
import Layout from "../../layouts/Layout.astro";
import db from "../../lib/db";
const rows=db.prepare("SELECT name,email FROM teachers ORDER BY name").all();
---
<Layout title="Enseignants"><h1>Enseignants</h1><table><thead><tr><th>Nom</th><th>Email</th></tr></thead><tbody>{rows.map(teacher=><tr><td>{teacher.name}</td><td>{teacher.email}</td></tr>)}</tbody></table></Layout>